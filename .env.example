# Conexão direta com o Postgres do Supabase — usada só pelos scripts de carga
# (scripts/carregar-banco.mjs). Nunca vai para o navegador.
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Credenciais que o app usa no navegador. A anon key é pública por natureza —
# quem controla o acesso são as policies de RLS (leitura só para autenticados).
# Project Settings → API no painel do Supabase.
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>
